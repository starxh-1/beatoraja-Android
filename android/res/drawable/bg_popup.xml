<?xml version="1.0" encoding="utf-8"?>
<!-- Spinner 下拉面板背景。
     原来 Spinner 的 popupBackground 直接给了一个**颜色值**（先是 #F2333333，
     后来换成同色系的深灰），**颜色**画出来永远是直角矩形 —— 这就是"输入框已经是圆角了，
     但点开游玩选项/音频可视化之后，弹出的那一列选项还是方框"的原因。
     popupBackground 接受 drawable，换成带 corners 的 shape 即可。

     底色用纯黑（同整页底色）：用户要求背景全黑，不给"灰底"。
     纯黑底上靠 1dp 描边 + 列表高光把面板的边界和当前项标出来。
     面板圆角与列表高光（list_selector_highlight）用同一个 corner_radius，
     所以第一/最后一项的高光会正好贴在圆角上，不会露出直角。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_page" />
    <stroke
        android:width="1dp"
        android:color="@color/surface_stroke" />
    <corners android:radius="@dimen/corner_radius" />
</shape>
