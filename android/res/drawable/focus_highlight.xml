<?xml version="1.0" encoding="utf-8"?>
<!-- 手柄高光（普通态）：套在"当前聚焦控件"外面的一层 View（见 SettingsActivity.updateFocusIndicator）。
     圆角要与输入类控件的 corner_radius 一致，否则高光框和它框住的控件边缘会对不上。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/accent_fill_weak" />
    <stroke
        android:width="2dp"
        android:color="@color/accent" />
    <corners android:radius="@dimen/corner_radius" />
</shape>
