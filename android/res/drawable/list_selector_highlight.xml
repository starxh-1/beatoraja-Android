<?xml version="1.0" encoding="utf-8"?>
<!-- 列表高光：用于 Spinner 下拉列表的"当前行"高亮，以及主题里的 android:listSelector。
     原来下拉项自带不透明纯色背景，而 list selector 是画在项背景下面的，
     于是手柄/键盘移动时完全看不到光标落在哪一项（音频可视化等所有下拉都是这个问题）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/list_highlight" />
    <corners android:radius="@dimen/corner_radius" />
</shape>
