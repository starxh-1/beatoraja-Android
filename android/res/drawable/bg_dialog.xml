<?xml version="1.0" encoding="utf-8"?>
<!-- 对话框面板背景（GdxDialogTheme 的 windowBackground）。
     之前这里直接给了 @color/surface 一个颜色 —— 颜色一定是直角矩形，
     等于把 Material 对话框自带的圆角给抹掉了（对话框反而不如系统默认好看）。
     换成 shape 后圆角回来，和输入框/下拉面板同一套半径。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke
        android:width="1dp"
        android:color="@color/surface_stroke" />
    <corners android:radius="@dimen/corner_radius" />
</shape>
