<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Language Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Language / 言語 / 语言"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/languageSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="#333333" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_powered_by"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="32dp"/>

        <!-- Audio Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_audio"
            android:textSize="20sp"
            android:textColor="#4FC3F7"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/system_volume"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <SeekBar
                android:id="@+id/systemVolumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                                android:max="100"
                android:progress="100"
                android:progressTint="#4FC3F7"
                android:thumbTint="#4FC3F7"/>

            <TextView
                android:id="@+id/volumePercent"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="end|center_vertical"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/key_volume"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <SeekBar
                android:id="@+id/keyVolumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                                android:max="100"
                android:progress="100"
                android:progressTint="#4FC3F7"
                android:thumbTint="#4FC3F7"/>

            <TextView
                android:id="@+id/keyVolumePercent"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:text="100%">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/bgm_volume"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/bgmVolumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#4FC3F7"
                android:thumbTint="#4FC3F7" />

            <TextView
                android:id="@+id/bgmVolumePercent"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="end|center_vertical"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sample_rate"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Spinner
                android:id="@+id/sampleRateSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="#333333"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- Player Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_player"
            android:textSize="20sp"
            android:textColor="#4FC3F7"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/select_player"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Spinner
                android:id="@+id/playerSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="#333333"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/newPlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/new_player"
                android:textSize="12sp"
                android:backgroundTint="#4FC3F7"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/deletePlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:text="@string/delete"
                android:textSize="12sp"
                android:backgroundTint="#AA3333"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/exportScoreBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:text="@string/export"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/importPlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/import_score_db"
                android:textSize="12sp"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- BMS Path Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_bms_path"
                android:textSize="20sp"
                android:textColor="#4FC3F7"/>

            <Button
                android:id="@+id/addBmsPathBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/add"
                android:textSize="12sp"
                android:backgroundTint="#4FC3F7"
                android:textColor="#000000"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_remove"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/bmsPathContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- Play Options Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_play_options"
            android:textSize="20sp"
            android:textColor="#4FC3F7"
            android:layout_marginBottom="16dp"/>

        <!-- Gauge Auto Shift -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="@string/show_audio_spectrum"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/showAudioSpectrumSwitch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true" />
        </LinearLayout>

        <!-- BGA Display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bga_display"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Spinner
                android:id="@+id/bgaDisplaySpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="#333333"/>
        </LinearLayout>

        <!-- BGA Expand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bga_expand"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Spinner
                android:id="@+id/bgaExpandSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="#333333"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/gauge_auto_shift"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Spinner
                android:id="@+id/gaugeAutoShiftSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="#333333"/>
        </LinearLayout>

        <!-- Auto Save Replay 1,2,3,4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_save_replay"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <Spinner
                    android:id="@+id/autoSaveReplay1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#333333"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <Spinner
                    android:id="@+id/autoSaveReplay2"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#333333"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <Spinner
                    android:id="@+id/autoSaveReplay3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#333333"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <Spinner
                    android:id="@+id/autoSaveReplay4"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#333333"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Green Number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/green_number"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <EditText
                android:id="@+id/greenNumberInput"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:background="#333333"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:inputType="number"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- HI-SPEED Fix -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hispeed_fix"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Spinner
                android:id="@+id/hispeedFixSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="#333333"/>
        </LinearLayout>

        <!-- ENABLE LANECOVER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enable_lanecover"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Switch
                android:id="@+id/enableLanecoverSwitch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true" />
        </LinearLayout>

        <!-- ENABLE LIFT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enable_lift"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Switch
                android:id="@+id/enableLiftSwitch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="false" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>


        <!-- Table Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_tables"
                android:textSize="20sp"
                android:textColor="#4FC3F7"/>

            <Button
                android:id="@+id/addTableUrlBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/add"
                android:textSize="12sp"
                android:backgroundTint="#4FC3F7"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/updateAllTablesBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="@string/update_all"
                android:textSize="12sp"
                android:backgroundTint="#FF9800"
                android:textColor="#000000"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_remove"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/tableUrlContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:paddingBottom="200dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="end">


            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#4FC3F7"
                android:text="@string/start_game"
                android:textColor="#000000" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
