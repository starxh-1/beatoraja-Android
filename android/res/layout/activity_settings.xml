<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beatoraja Settings"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android audio powered by Oboe"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="32dp"/>

        <!-- Audio Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio"
            android:textSize="20sp"
            android:textColor="#4FC3F7"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="System Volume"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <SeekBar
                android:id="@+id/systemVolumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#4FC3F7"
                android:thumbTint="#4FC3F7"/>

            <TextView
                android:id="@+id/volumePercent"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="end|center_vertical"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Key Volume"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <SeekBar
                android:id="@+id/keyVolumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#4FC3F7"
                android:thumbTint="#4FC3F7"/>

            <TextView
                android:id="@+id/keyVolumePercent"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="end|center_vertical"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BGM Volume"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <SeekBar
                android:id="@+id/bgmVolumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="#4FC3F7"
                android:thumbTint="#4FC3F7"/>

            <TextView
                android:id="@+id/bgmVolumePercent"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="end|center_vertical"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- Player Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Player"
            android:textSize="20sp"
            android:textColor="#4FC3F7"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Player"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Spinner
                android:id="@+id/playerSpinner"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:background="#333333"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/newPlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="+ New Player"
                android:textSize="12sp"
                android:backgroundTint="#4FC3F7"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/deletePlayerBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:text="Delete"
                android:textSize="12sp"
                android:backgroundTint="#AA3333"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/exportScoreBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:text="Export"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- BMS Path Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BMS Paths"
                android:textSize="20sp"
                android:textColor="#4FC3F7"/>

            <Button
                android:id="@+id/addBmsPathBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Add"
                android:textSize="12sp"
                android:backgroundTint="#4FC3F7"
                android:textColor="#000000"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to remove"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/bmsPathContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- IR Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Internet Ranking"
            android:textSize="20sp"
            android:textColor="#4FC3F7"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable IR"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Switch
                android:id="@+id/irEnableSwitch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IR Send Count"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <Spinner
                android:id="@+id/irSendCountSpinner"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:background="#333333"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- Table Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Difficulty Tables"
                android:textSize="20sp"
                android:textColor="#4FC3F7"/>

            <Button
                android:id="@+id/addTableUrlBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Add"
                android:textSize="12sp"
                android:backgroundTint="#4FC3F7"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/updateAllTablesBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="Update All"
                android:textSize="12sp"
                android:backgroundTint="#FF9800"
                android:textColor="#000000"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to remove"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/tableUrlContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp"
            android:paddingBottom="200dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginVertical="16dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:gravity="end">

            
            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save &amp; Play"
                android:backgroundTint="#4FC3F7"
                android:textColor="#000000"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>